# Supabase Configuration
# Get these values from your Supabase project dashboard: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# Application Configuration
# ============================================
NEXT_PUBLIC_APP_NAME=your-app-name
NEXT_PUBLIC_APP_URL=your-app-url
NEXT_PUBLIC_DEFAULT_CURRENCY=your-default-currency
NEXT_PUBLIC_DEFAULT_TIMEZONE=your default-timezone

# ============================================
# M-Pesa Configuration (Optional - for payments)
# ============================================
# Safaricom Daraja API credentials
NEXT_PUBLIC_MPESA_CONSUMER_KEY=your-consumer-key
NEXT_PUBLIC_MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_PASSKEY=your-passkey
MPESA_SHORTCODE=your-shortcode
MPESA_CALLBACK_URL=your-callback-url